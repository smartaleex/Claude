# ============================================================
# Zetaris Sales Prospector — Environment Configuration
# Copy to .env and fill in your keys
# ============================================================

# --- Anthropic (REQUIRED) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- GitHub (strongly recommended — raises rate limit from 60 to 5,000 req/hr) ---
GITHUB_TOKEN=ghp_...

# --- News APIs ---
GUARDIAN_API_KEY=your-guardian-api-key
NEWS_API_KEY=your-newsapi-org-key

# --- Job Postings (Adzuna) ---
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key

# --- Tech Stack Detection ---
# python-Wappalyzer works with no key; DetectZeStack adds DNS/TLS coverage
DETECTZESTACK_API_KEY=your-detectzestack-key

# --- Email/Company Enrichment ---
HUNTER_API_KEY=your-hunter-io-key

# --- Application Settings ---
DATABASE_URL=sqlite+aiosqlite:///./zetaris_prospects.db
LOG_LEVEL=INFO
MAX_CONCURRENT_ENRICHMENTS=3

# --- Claude Model Settings ---
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_SYNTHESIS_MAX_TOKENS=1500
CLAUDE_OUTREACH_MAX_TOKENS=800
